# Mastra Gateway — single key that proxies to OpenAI, Anthropic, Google, etc.
# Required: all three agents use the model "google/gemini-3.5-flash-lite".
# https://mastra.ai/docs/models/gateways/mastra
MASTRA_GATEWAY_API_KEY=

# Supabase REST client — used by every listing/vehicle tool.
# Supabase Dashboard → Project Settings → API
# The service role key bypasses RLS. Server-side only, never ship it to a client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string — used by PostgresStore for agent memory
# and observability spans (schema: mastra_memory).
# Supabase Dashboard → Connect → Connection string
# NOTE: the variable name is misspelled ("SUPBASE") in src/mastra/index.ts.
# Keep the spelling below in sync with the code.
SUPBASE_POSTGRES=

# Bright Data — powers the research agent's webSearch / webFetch tools.
# https://brightdata.com
BRIGHTDATA_API_TOKEN=

# Optional Bright Data zone overrides. Leave blank to use account defaults.
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_WEB_UNLOCKER_ZONE=
